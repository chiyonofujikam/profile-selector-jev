# Local PostgreSQL. Keep DATABASE_URL aligned with POSTGRES_* for manual startup.
# The launcher prompts for a missing password and writes the matching DATABASE_URL.
POSTGRES_DB=jev
POSTGRES_USER=jev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://jev:your-password@127.0.0.1:5432/jev

# Set DECISION_PROVIDER=jev and supply a key for live Jev calls.
DECISION_PROVIDER=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Optional backend settings; shown with their defaults.
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=2
# CANDIDATE_FILTER_BUDGET=30
# SELECT_THRESHOLD=0.7
# REJECT_THRESHOLD=0.3
# MAX_FILTERS_PER_CATEGORY=10
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
