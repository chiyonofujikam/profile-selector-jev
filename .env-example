# Copy settings into .env as needed. Do not overwrite an existing .env.
POSTGRES_DB=jev
POSTGRES_USER=jev
POSTGRES_PASSWORD=jev_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jev:jev_local@127.0.0.1:5432/jev

# Use mock for local rules, or jev for TypeSafe System One.
DECISION_PROVIDER=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
